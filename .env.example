# 复制为仓库根目录的 .env。不要提交 .env。
# 已经写在系统环境里的同名变量不会被这个文件覆盖。

LLM_API_KEY=
# 不写 LLM_MODEL 时，程序默认用 gpt-5.5
LLM_MODEL=gpt-5.5
# 用服务商默认地址时留空
# LLM_BASE_URL=

# 兼容接口（例如百炼）示例：
# LLM_API_KEY=sk-...
# LLM_MODEL=openai/qwen3.8-flash
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_DROP_PARAMS=true
